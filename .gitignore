cat > .gitignore <<'EOF'
# =========================
# Environment / secrets
# =========================
.env
.env.*
!.env.example
*.pem
*.key

# =========================
# Python
# =========================
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# =========================
# Testing
# =========================
.pytest_cache/
.coverage
htmlcov/

# =========================
# Logs
# =========================
logs/
*.log

# =========================
# Generated / rejected data
# =========================
data/generated/
data/rejected/
data/archive/

# =========================
# Airflow local runtime
# =========================
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg
airflow/webserver_config.py
airflow/standalone_admin_password.txt

# =========================
# dbt generated files
# =========================
dbt_novacart/target/
dbt_novacart/logs/
dbt_novacart/dbt_packages/
dbt_novacart/profiles.yml
target/
dbt_packages/

# =========================
# Power BI
# =========================
*.pbix
*.pbit

# =========================
# IDE / local tooling
# =========================
.vscode/
.idea/
.claude/

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Terraform local state
# =========================
.terraform/
*.tfstate
*.tfstate.*
EOF*:Zone.Identifier
